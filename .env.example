# Firebase web app config — copy this file to `.env.local` and fill in the values
# from Firebase console > Project settings > Your apps > Web app > SDK setup.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
# Newer projects use "<project>.firebasestorage.app"; older ones "<project>.appspot.com".
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: point the app at the local emulator suite (npm run emulators).
# VITE_USE_EMULATORS=true

# Disable legacy email sign-in after all accounts have migrated to phone numbers.
# VITE_ALLOW_LEGACY_EMAIL_LOGIN=false
